{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2022"],
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true,
    "noEmit": true, "types": ["bun"], "isolatedModules": true, "baseUrl": ".", "paths": { "@/*": ["src/*"] }
  },
  "include": ["src"]
}
