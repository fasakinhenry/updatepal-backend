# required
MONGODB_URI=mongodb://localhost:27017/updatebase
# at least 32 random characters. generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-of-32-chars-or-more
# the exact origin of the frontend (cors and email links)
CLIENT_ORIGIN=http://localhost:5173
# optional
PORT=4000
NODE_ENV=development
GOOGLE_CLIENT_ID=
# ai features (formatter, profile curator, search). without a key the app uses rule based fallbacks.
# AI_PROVIDER is gemini (free tier), anthropic or none. change it any time, no code changes needed.
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# optional. defaults: gemini-2.5-flash for gemini, claude-haiku-5-5 for anthropic
AI_MODEL=
# the one email allowed into /admin (must be a verified account)
ADMIN_EMAIL=
# payments: none or bachs. use a sandbox key (sk_sandbox_...) first
# comma separated: bachs, paypal (empty = payments off)
PAYMENT_PROVIDERS=
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
PAYMENT_CURRENCY=NGN
# paypal (use sandbox credentials from developer.paypal.com first). paypal does not support NGN, so it settles in another currency
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
PAYPAL_PAYOUTS=false
# public base url of this api (for uploaded images), for example https://api.example.com
API_PUBLIC_URL=
# platform fee in basis points (100 = 1%). admins can change it later in the admin panel
PLATFORM_FEE_BPS=0
# openssl rand -base64 32. needed for withdrawals (encrypts bank details)
DATA_ENCRYPTION_KEY=
RESEND_API_KEY=
MAIL_FROM=updatebase <onboarding@resend.dev>
# local (development) or s3 (production). s3 works with aws, cloudflare r2, backblaze b2 and minio
STORAGE_DRIVER=local
STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=25
